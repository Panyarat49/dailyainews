# Daily AI News — environment variables
#
# Two surfaces, two purposes:
#
#   A. The skill (runs in the Routine) reads GITHUB_* from either an
#      inline prompt paste or from .claude/skills/daily-ai-news/reference/
#      defaults.json. This file is a cheat sheet — not read by anything.
#
#   B. The GitHub Actions workflow (.github/workflows/email-notify.yml)
#      reads MAIL_* from GitHub repo secrets:
#        Repo -> Settings -> Secrets and variables -> Actions
#      The workflow is where MAIL_* actually need to live — do NOT put
#      them in the Routine prompt or anywhere in the repo.
#
# Never commit a real .env — see .gitignore.

# --- A. GitHub target (used by the skill) ---------------------------------
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=dailyainews
GITHUB_BRANCH=main

# --- B. Email / Office 365 SMTP (used by GH Actions, NOT by the skill) ----
# The mailbox login that sends the brief. For Office 365 this is the full
# email address. Set as a GitHub repo secret named MAIL_USERNAME.
MAIL_USERNAME=you@yourcompany.com

# Mailbox password or app password. If the account has MFA, generate an
# app password and use that. Set as a GitHub repo secret named MAIL_PASSWORD.
MAIL_PASSWORD=

# Recipient(s). Comma-separated for more than one. Secret name: MAIL_TO.
MAIL_TO=recipient@yourcompany.com

# Optional. From address shown to recipients. Defaults to MAIL_USERNAME.
MAIL_FROM=

# Optional. SMTP host/port. Defaults to smtp.office365.com:587 (STARTTLS).
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
